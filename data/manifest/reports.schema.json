{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/w-harda/RAG/blob/main/data/manifest/reports.schema.json",
  "title": "APT 报告语料清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "created_at", "reports"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "reports": {
      "type": "array",
      "minItems": 15,
      "items": {"$ref": "#/$defs/report"}
    }
  },
  "$defs": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "title",
        "vendor",
        "apt_group",
        "publish_date",
        "language",
        "url",
        "download_url",
        "local_path",
        "format",
        "file_size",
        "sha256",
        "tags"
      ],
      "properties": {
        "report_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "apt_group": {"type": "string", "minLength": 1},
        "publish_date": {"type": "string", "format": "date"},
        "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "download_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "local_path": {"type": "string", "pattern": "^data/raw/[a-z0-9-]+/[a-z0-9-]+\\.pdf$"},
        "format": {"const": "pdf"},
        "file_size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    }
  }
}
