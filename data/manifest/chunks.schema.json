{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/w-harda/RAG/blob/main/data/manifest/chunks.schema.json",
  "title": "APT 报告 Chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunk_id",
    "chunk_index",
    "report_id",
    "document_title",
    "vendor",
    "apt_group",
    "publish_date",
    "language",
    "page",
    "section",
    "source_url",
    "text",
    "char_count",
    "text_sha256"
  ],
  "properties": {
    "chunk_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-p[0-9]{4}-c[0-9]{3}$"
    },
    "chunk_index": {"type": "integer", "minimum": 0},
    "report_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "document_title": {"type": "string", "minLength": 1},
    "vendor": {"type": "string", "minLength": 1},
    "apt_group": {"type": "string", "minLength": 1},
    "publish_date": {"type": "string", "format": "date"},
    "language": {"type": "string", "minLength": 2},
    "page": {"type": "integer", "minimum": 1},
    "section": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "text": {"type": "string", "minLength": 1},
    "char_count": {"type": "integer", "minimum": 1},
    "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
